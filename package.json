{
  "name": "celerity-node-sdk",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/newstack-cloud/celerity-node-sdk.git"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest",
    "test:unit": "vitest run --coverage",
    "test:unit:no-cov": "vitest run",
    "test:integration": "bash scripts/integration-test.sh --coverage tests/integration/",
    "test:integration:no-cov": "bash scripts/integration-test.sh tests/integration/",
    "test:all": "bash scripts/integration-test.sh --coverage",
    "test:all:no-cov": "bash scripts/integration-test.sh",
    "lint": "eslint packages/",
    "lint:fix": "eslint packages/ --fix",
    "lint:report": "eslint packages/ -f json -o eslint-report.json || true",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@celerity-sdk/runtime": "^0.4.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.0.0",
    "@swc/core": "^1.15.11",
    "@types/debug": "^4.1.0",
    "@types/node": "^25.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10",
    "ws": "^8.21.0"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "^5.5.6",
      "fast-xml-builder": "1.1.7",
      "minimatch": "^9.0.7",
      "rollup": "^4.59.0",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "lodash": "4.18.0",
      "vite": "7.3.5",
      "protobufjs": "7.6.1",
      "fast-uri": "3.1.5",
      "brace-expansion": "5.0.9",
      "postcss": "8.5.18",
      "js-yaml": "^4.3.1",
      "@grpc/grpc-js": "^1.14.4",
      "nanoid": "^3.3.18"
    }
  }
}
